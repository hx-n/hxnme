{
  "name": "hxnme",
  "version": "0.0.1",
  "license": "Apache",
  "url": "https://github.com/hx-n/hxnme",
  "description": "The hxn media engine (hxnme) kernel: the app loop, frame scheduler, plugin registry, math and asset base that its plugins build on",
  "contributors": [
    "darmie"
  ],
  "releasenote": "Math types.",
  "classPath": "src",
  "dependencies": {
    "hxn": "",
    "hxn-assets": "0.2.2"
  },
  "tags": [
    "hashlink",
    "hxcpp",
    "native",
    "cppia",
    "wasm",
    "cross",
    "engine"
  ],
  "hxn": {
    "cli": {
      "version": 1,
      "command": [
        "haxe",
        "-cp",
        "{root}/tools",
        "-cp",
        "{root}/src",
        "--run",
        "hxn.me.cli.Tool"
      ],
      "hooks": [
        "before-build"
      ]
    }
  }
}
